{
  "name": "repertoire",
  "description": "A Music Application developed entirely in React and TypeScript",
  "version": "0.14.1",
  "license": "MIT",
  "type": "module",
  "compiler": {
    "target": "19"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --verbose",
    "build": "tsc -b && vite build",
    "format": "prettier --write .",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "repertoire.ui": "file:../repertoire.ui"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@mantine/core": "^9.3.0",
    "@mantine/emotion": "^9.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.3.5"
  }
}
